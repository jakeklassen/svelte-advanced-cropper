{
  "name": "svelte-advanced-cropper",
  "type": "module",
  "version": "0.0.0",
  "description": "A Svelte component library for advanced image cropping.",
  "author": "Jake Klassen <jklassendev@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/jakeklassen/svelte-advanced-cropper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakeklassen/svelte-advanced-cropper.git"
  },
  "bugs": {
    "url": "https://github.com/jakeklassen/svelte-advanced-cropper/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "test": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.6.2",
    "@vitest/browser-playwright": "^4.1.5",
    "bumpp": "^11.1.0",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "svelte-preprocess": "^6.0.3",
    "svelte2tsx": "^0.7.55",
    "tsdown": "0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "vitest-browser-svelte": "^2.1.1",
    "storybook": "^10.4.1",
    "@storybook/svelte-vite": "^10.4.1",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "playwright": "^1.60.0",
    "@vitest/coverage-v8": "4.1.7"
  }
}
