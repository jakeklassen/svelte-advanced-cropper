{
	"name": "svelte-advanced-cropper",
	"version": "0.1.3",
	"description": "Svelte 5 port of react-advanced-cropper: build croppers exactly suited to your design",
	"keywords": [
		"advanced-cropper",
		"cropper",
		"image-cropper",
		"svelte"
	],
	"homepage": "https://jakeklassen.github.io/svelte-advanced-cropper/",
	"bugs": {
		"url": "https://github.com/jakeklassen/svelte-advanced-cropper/issues"
	},
	"license": "MIT",
	"author": "Jake Klassen",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jakeklassen/svelte-advanced-cropper.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"CHANGELOG.md"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#site/*": "./src/site/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./style.css": "./dist/style.css",
		"./themes/*": "./dist/themes/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && node scripts/build-styles.ts && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts --watch",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"version-packages": "changeset version && oxfmt CHANGELOG.md package.json",
		"release": "changeset publish"
	},
	"dependencies": {
		"advanced-cropper": "~0.17.1"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@lucide/svelte": "^1.52.0",
		"@playwright/test": "^1.60.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.4",
		"@vitest/browser-playwright": "^5.0.3",
		"autoprefixer": "^10.6.1",
		"heic-to": "^1.6.5",
		"mdsvex": "^0.12.8",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"playwright": "^1.60.0",
		"postcss": "^8.5.29",
		"publint": "^0.3.21",
		"sass": "^1.105.1",
		"shiki": "^4.5.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	},
	"peerDependencies": {
		"svelte": "^5.29.0"
	}
}
